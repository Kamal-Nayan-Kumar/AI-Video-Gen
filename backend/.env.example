# API keys are optional. Leave this file absent to run in demo mode, where
# content, narration and imagery are all produced locally and the full
# pipeline still runs end to end.

# --- Outline, narration script and animation code -------------------------
# Each additional key becomes an automatic fallback, tried in this order:
#   Groq -> OpenRouter -> Gemini -> local demo content.
# Only one is required; adding more just makes the run more resilient.

# Preferred: fast and free-tier friendly.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Fallback. Multi-provider router.
OPENROUTER_API_KEY=
# Universal router IDs:
#   openrouter/auto  — routes by prompt. Billed at the chosen model's rates,
#                      roughly a tenth of a cent per deck. This is the default.
#   openrouter/free  — picks a random free model. Zero cost, but shares a
#                      50-request/day cap and returns an empty response to
#                      roughly one request in three, so a run falls through to
#                      local content instead.
# OPENROUTER_MODEL=openrouter/auto

# Final fallback, using the native SDK.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Narration ------------------------------------------------------------
# Sarvam AI. Note that bulbul:v2 and its speakers were retired; v3 requires
# the speaker names in Config.SARVAM_SPEAKER_MAP.
SARVAM_API_KEY=
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_MODEL=bulbul:v3

# --- Imagery --------------------------------------------------------------
# Real photographs from Unsplash. Without it, a deterministic abstract plate
# is generated per slide.
UNSPLASH_ACCESS_KEY=

# Optional tuning
# MANIM_QUALITY=m      # l=low, m=medium, h=high
# MANIM_FPS=30
# HOST=0.0.0.0
# PORT=8000            # change this if 8000 is already taken
# DEMO_MODE=1          # force demo mode even when keys are present
